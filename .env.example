# Copier en `.env` (non versionne) et renseigner les VRAIS secrets avant `docker compose up`.
# Ce fichier est un TEMPLATE versionne : il ne doit JAMAIS contenir de secret reel,
# uniquement des placeholders.

# Mot de passe de l'utilisateur applicatif MySQL `medilabo` (schemas patient + auth).
DB_PASSWORD=<a-renseigner-dans-.env>

# Mot de passe root MySQL (administration de l'instance, jamais utilise par les services).
DB_ROOT_PASSWORD=<a-renseigner-dans-.env>
